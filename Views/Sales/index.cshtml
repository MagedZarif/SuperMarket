@{
    Layout = "_Layout";
}
<h2 class="text-center">Make a Sale</h2>

<div class="row mt-3">
    <div class="col-md-4">
        <label class="form-label">Category</label>
        <select id="categorySelect" class="form-select" onchange="loadItems()">
            <option value="">Select Category</option>
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Item</label>
        <select id="itemSelect" class="form-select" onchange="loadIItems()">
            <option value="">Select Item</option>
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">IItems</label>
        <select id="iitemSelect" class="form-select"></select>
    </div>
</div>

<button class="btn btn-success mt-3" onclick="addToCart()">Add to Sale</button>
<h4>Total: $<span id="totalPrice">0.00</span></h4>

<button class="btn btn-primary mt-3" onclick="completeSale()">Complete Sale</button>

@section Scripts {
<script src="~/js/sales.js"></script>
}
